{
  "name": "serenia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "build:isolated": "node scripts/build-isolated.mjs",
    "workflow:wire": "node scripts/workflow-wire.mjs verify",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "db:test": "python3 scripts/test-database.py",
    "supabase:local": "node scripts/supabase-local.mjs",
    "db:lint": "node scripts/supabase-local.mjs db lint --local --schema public --level warning --fail-on warning",
    "db:advisors": "node scripts/supabase-local.mjs db advisors --local --type all --level warn --fail-on warn",
    "db:types:check": "node scripts/database-types.mjs check",
    "db:types:generate": "node scripts/database-types.mjs generate",
    "db:verify": "npm run db:lint && npm run db:advisors && npm run db:types:check"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.306",
    "@base-ui/react": "1.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@workflow/next": "4.1.17",
    "ai": "6.0.303",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "workflow": "4.8.13",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "jsdom": "29.1.1",
    "supabase": "2.120.0",
    "tailwindcss": "4.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "8.3.4"
  },
  "overrides": {
    "@workflow/core": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16"
    }
  },
  "engines": {
    "node": ">=24.14.1 <25"
  }
}
