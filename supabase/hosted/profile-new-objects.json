          "definition": "CREATE UNIQUE INDEX profile_extraction_jobs_pkey ON public.profile_extraction_jobs USING btree (id)"
        },
        {
          "name": "profile_extraction_jobs_source_message_id_key",
          "definition": "CREATE UNIQUE INDEX profile_extraction_jobs_source_message_id_key ON public.profile_extraction_jobs USING btree (source_message_id)"
        },
        {
          "name": "profile_job_conversation_owner_index",
