          "definition": "CREATE UNIQUE INDEX profile_job_observation_source ON public.profile_extraction_jobs USING btree (id, user_id, source_message_id, source_created_at)"
        },
        {
          "name": "profile_job_one_active_user",
          "definition": "CREATE UNIQUE INDEX profile_job_one_active_user ON public.profile_extraction_jobs USING btree (user_id) WHERE (status = ANY (ARRAY['enqueued'::text, 'running'::text]))"
        },
        {
          "name": "profile_job_pending_order",
          "definition": "CREATE INDEX profile_job_pending_order ON public.profile_extraction_jobs USING btree (user_id, source_created_at, id) WHERE (status = ANY (ARRAY['pending'::text, 'enqueued'::text, 'running'::text]))"
        },
        {
          "name": "profile_job_session_owner_index",
