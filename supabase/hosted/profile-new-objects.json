        {
          "name": "profile_observations_category_check",
          "definition": "CHECK ((category = ANY (ARRAY['concern'::text, 'goal'::text, 'context'::text, 'functioning'::text, 'resource'::text, 'preference'::text, 'history'::text, 'agreement'::text])))"
        },
        {
          "name": "profile_observations_check",
          "definition": "CHECK ((supersedes_id IS DISTINCT FROM id))"
        },
        {
          "name": "profile_observations_id_user_id_key",
          "definition": "UNIQUE (id, user_id)"
        },
        {
          "name": "profile_observations_job_id_category_quote_key",
          "definition": "UNIQUE (job_id, category, quote)"
        },
        {
          "name": "profile_observations_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "profile_observations_quote_check",
          "definition": "CHECK (((char_length(quote) >= 1) AND (char_length(quote) <= 400)))"
        },
        {
          "name": "profile_observations_status_check",
          "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'confirmed'::text, 'rejected'::text, 'superseded'::text])))"
        },
        {
          "name": "profile_observations_time_scope_check",
          "definition": "CHECK ((time_scope = ANY (ARRAY['current'::text, 'historical'::text, 'unspecified'::text])))"
        },
        {
          "name": "profile_observations_user_id_fkey",
          "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        }
