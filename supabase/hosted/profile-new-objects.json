      ],
      "policies": null,
      "triggers": [
        {
          "name": "validate_profile_source",
          "enabled": "O",
          "definition": "CREATE TRIGGER validate_profile_source BEFORE INSERT OR UPDATE ON public.profile_extraction_jobs FOR EACH ROW EXECUTE FUNCTION validate_profile_source()"
        }
      ],
      "force_rls": false,
      "constraints": [
        {
          "name": "profile_extraction_jobs_attempts_check",
          "definition": "CHECK (((attempts >= 0) AND (attempts <= 3)))"
        },
        {
          "name": "profile_extraction_jobs_consent_epoch_check",
          "definition": "CHECK ((consent_epoch >= 0))"
        },
        {
          "name": "profile_extraction_jobs_error_code_check",
          "definition": "CHECK ((error_code = ANY (ARRAY['processing_failed'::text, 'claims_exhausted'::text, 'consent_withdrawn'::text])))"
        },
        {
          "name": "profile_extraction_jobs_extractor_version_check",
          "definition": "CHECK ((extractor_version = 'profile-v1'::text))"
        },
        {
          "name": "profile_extraction_jobs_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "profile_extraction_jobs_source_message_id_key",
          "definition": "UNIQUE (source_message_id)"
        },
        {
          "name": "profile_extraction_jobs_status_check",
          "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'enqueued'::text, 'running'::text, 'completed'::text, 'cancelled'::text, 'exhausted'::text])))"
        },
        {
          "name": "profile_extraction_jobs_user_id_fkey",
          "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        },
        {
          "name": "profile_job_active_lease",
          "definition": "CHECK (((status = ANY (ARRAY['enqueued'::text, 'running'::text])) = (lease_until IS NOT NULL)))"
        },
        {
          "name": "profile_job_conversation_owner",
          "definition": "FOREIGN KEY (conversation_id, user_id) REFERENCES conversations(id, user_id) ON DELETE CASCADE"
        },
        {
          "name": "profile_job_observation_source",
          "definition": "UNIQUE (id, user_id, source_message_id, source_created_at)"
        },
        {
          "name": "profile_job_session_owner",
          "definition": "FOREIGN KEY (session_id, user_id) REFERENCES clinical_sessions(id, user_id) ON DELETE CASCADE"
        },
        {
          "name": "profile_job_source",
          "definition": "FOREIGN KEY (source_message_id, session_id, conversation_id, source_created_at) REFERENCES messages(id, session_id, conversation_id, created_at) ON DELETE CASCADE"
        }
